# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Hot-Reload marker — local dev artifact.
.hotreload

# Local deploy targets for `npm run deploy` / `npm run push`. Machine-specific
# vault paths — keep the committed deploy-targets.example.json as the template.
deploy-targets.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Demo vault — Obsidian writes workspace state every close.
docs/demo-vault/.obsidian/workspace.json
docs/demo-vault/.obsidian/workspace-mobile.json

# E2E test vault (tests/e2e/jf-e2e-vault) — the committed fixtures and
# .obsidian config ARE tracked, but a few artifacts must not be:
#   - the built main.js is deployed fresh each run (global `main.js` rule covers it)
#   - Obsidian rewrites workspace state on every close
tests/e2e/jf-e2e-vault/.obsidian/workspace*.json
# Obsidian rewrites appearance.json (accent colour, etc.) on every session.
tests/e2e/jf-e2e-vault/.obsidian/appearance.json
# ...but the deterministic baseline plugin settings MUST be committed, so
# re-include it despite the global `data.json` rule above.
!tests/e2e/jf-e2e-vault/.obsidian/plugins/journal-folder/data.json

# Repo root accidentally opened as an Obsidian vault — config has no
# purpose here (not the demo vault, not a deploy target). Keep local, untrack.
/.obsidian/

# Screenshot harness: saved full-window frames + sidecar rects. Kept between
# runs so `npm run screenshots -- --recrop` can re-cut crops without re-driving
# Obsidian; not committed (large, machine-local).
scripts/screenshots/.captures/
