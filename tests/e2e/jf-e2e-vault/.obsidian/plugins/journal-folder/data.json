        "explore"
      ],
      "icon": {
        "source": {
          "kind": "lucide",
          "name": "eye"
        },
        "color": {
          "kind": "token",
          "var": "--color-blue"
        }
      }
    }
  ],
  "signifierHideTagInReadingView": true,
  "signifierHideTagInLivePreview": true,
