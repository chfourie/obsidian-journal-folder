        "inspiration"
      ],
      "icon": {
        "source": {
          "kind": "lucide",
          "name": "lightbulb"
        },
        "color": {
          "kind": "token",
          "var": "--color-yellow"
        }
      }
    },
    {
      "id": "explore",
      "label": "Explore",
