      "tags": [
        "important"
      ],
      "icon": {
        "source": {
          "kind": "lucide",
          "name": "star"
        },
        "color": {
          "kind": "token",
          "var": "--color-yellow"
        }
      }
    },
    {
      "id": "local",
      "label": "Local",
      "tags": [
        "local"
      ],
      "maxRange": "day",
      "icon": {
        "source": {
          "kind": "lucide",
          "name": "house"
        },
        "color": {
          "kind": "token",
          "var": "--color-cyan"
        }
      }
    }
  ],
  "taskCategoryShowUnderNote": false,
  "signifierLivePreviewEnabled": true,
  "taskCheckboxStyle": "circle",
  "documentTasksEnabled": true
}