{
	"name": "journal-folder",
	"version": "3.1.5",
	"description": "Utilities for folder-based journaling",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"push": "node scripts/deploy-plugin.mjs",
		"deploy": "npm run build && node scripts/deploy-plugin.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "node tests/e2e/run.mjs",
		"test:e2e:build": "npm run build && node tests/e2e/run.mjs",
		"screenshots": "JF_E2E_VAULT=demo-vault node scripts/screenshots/run.mjs",
		"release": "node scripts/release.mjs"
	},
	"keywords": [],
	"author": "Charl Fourie",
	"license": "GPL-3.0",
	"devDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^9.39.4",
		"@eslint/json": "^0.14.0",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^25.8.0",
		"@typescript-eslint/eslint-plugin": "^8.59.3",
		"@typescript-eslint/parser": "^8.59.3",
		"esbuild": "^0.28.0",
		"esbuild-svelte": "^0.9.5",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"jsdom": "^29.1.1",
		"obsidian": "latest",
		"prettier": "^3.8.3",
		"svelte": "^5.55.7",
		"svelte-preprocess": "^6.0.3",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^4.1.6"
	}
}
