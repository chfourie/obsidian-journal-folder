{
	"name": "journal-folder",
	"version": "3.5.0",
	"description": "Utilities for folder-based journaling",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"push": "node scripts/deploy-plugin.mjs",
		"deploy": "npm run build && node scripts/deploy-plugin.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "node tests/e2e/run.mjs",
		"test:e2e:build": "npm run build && node tests/e2e/run.mjs",
		"screenshots": "JF_E2E_VAULT=demo-vault node scripts/screenshots/run.mjs",
		"release": "node scripts/release.mjs"
	},
	"keywords": [],
	"author": "Charl Fourie",
	"license": "GPL-3.0",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^0.14.0",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^25.9.5",
		"@typescript-eslint/eslint-plugin": "^8.66.0",
		"@typescript-eslint/parser": "^8.66.0",
		"esbuild": "^0.28.2",
		"esbuild-svelte": "^0.9.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"jsdom": "^29.1.1",
		"obsidian": "latest",
		"prettier": "^3.9.6",
		"svelte": "^5.56.8",
		"svelte-eslint-parser": "^1.8.0",
		"svelte-preprocess": "^6.0.5",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vitest": "^4.1.10"
	},
	"comment:overrides": "Security patches for transitive dev dependencies whose parents pin vulnerable ranges. Each override stays inside the dependant's major line — crossing a major breaks the consumer (brace-expansion 5 and nanoid 6 are ESM-only; undici 8 drops the API jsdom's dispatcher uses).",
	"overrides": {
		"brace-expansion@1": "^1.1.18",
		"brace-expansion@2": "^2.1.4",
		"brace-expansion@4": "^5.0.9",
		"fast-uri@3": "^3.1.5",
		"js-yaml@4": "^4.3.1",
		"nanoid@3": "^3.3.18",
		"postcss": "^8.5.26",
		"undici@7": "^7.29.0"
	}
}
